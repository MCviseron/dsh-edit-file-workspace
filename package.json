{
  "name": "dsh-edit-file-workspace",
  "version": "0.3.0",
  "description": "DSH plugin — reassign a stored conversation to another workspace from the settings sidebar. Keeps the session title and timestamp intact. Compatible with DSH 0.2 desktop and web profiles.",
  "license": "MIT",
  "author": {
    "name": "dsh-edit-file-workspace contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCviseron/dsh-edit-file-workspace.git"
  },
  "homepage": "https://github.com/MCviseron/dsh-edit-file-workspace#readme",
  "bugs": {
    "url": "https://github.com/MCviseron/dsh-edit-file-workspace/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "workspace",
    "session",
    "session-log"
  ],
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit",
    "test": "node --experimental-strip-types --test test/logfile.test.ts test/persistence.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "node build.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.2.0-rc.2 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "esbuild": "^0.24.0",
    "immer": "10.2.0",
    "typescript": "~5.7.2",
    "zustand": "4.4.7"
  }
}
